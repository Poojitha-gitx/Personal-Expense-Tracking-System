# ====================================================================
# MySQL Database Credentials (Example Template)
# Copy or rename this file to .env and fill in your local MySQL details
# ====================================================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_username
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=expense_tracker_db

# Flask Application Secret Key (Replace with a random secure string)
SECRET_KEY=your_secure_random_flask_secret_key_here
