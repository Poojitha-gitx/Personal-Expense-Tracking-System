# ====================================================================
# Database Credentials Template (Local MySQL or TiDB Cloud)
# Rename this file to .env and configure your credentials locally
# ====================================================================

# Local MySQL Example:
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your_local_password
# MYSQL_DB=expense_tracker_db

# TiDB Cloud Example (Add these as Environment Variables in Vercel):
# MYSQL_HOST=your-cluster.tidbcloud.com
# MYSQL_PORT=4000
# MYSQL_USER=your_username.root
# MYSQL_PASSWORD=your_tidb_password
# MYSQL_DB=expense_tracker_db

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_username
MYSQL_PASSWORD=your_password
MYSQL_DB=expense_tracker_db

# Flask Application Secret Key (Replace with a random 32-byte string)
SECRET_KEY=your_secure_random_flask_secret_key_here
